<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_panel_madera"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AJUSTES"
        android:fontFamily="@font/press_start_2p"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/seek_musica"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:maxHeight="12dp"
        android:progressDrawable="@drawable/track_ajustado"
        android:thumb="@drawable/thumb_ajustado"
        android:splitTrack="false"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/tv_label_musica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MÚSICA"
        android:fontFamily="@font/press_start_2p"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/seek_musica"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <SeekBar
        android:id="@+id/seek_sfx"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:progressDrawable="@drawable/barracargadora"
        android:thumb="@drawable/garrita_vol"
        app:layout_constraintTop_toBottomOf="@id/tv_label_musica"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_label_sfx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EFECTOS (SFX)"
        android:fontFamily="@font/press_start_2p"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/seek_sfx"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_guardar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="GUARDAR Y SALIR"
        android:fontFamily="@font/press_start_2p"
        android:background="@drawable/boton_selector"
        app:backgroundTint="@null"
        android:textColor="#FFFFFF"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintTop_toBottomOf="@id/tv_label_sfx"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>